@model List<Product>
@{ViewData["Title"]="Thời trang nam";}
<div class="page-banner"><div class="container"><div class="eyebrow dark">MENSWEAR COLLECTION</div><h1>KHÁM PHÁ SẢN PHẨM</h1><p>Áo nam, quần nam và bộ vest cho phong cách của bạn.</p></div></div><div class="container py-5"><form method="get" class="row g-3 mb-4"><div class="col-md-5"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Tìm áo, quần, bộ vest nam..."/></div><div class="col-md-3"><select name="category" class="form-select"><option value="">Tất cả danh mục</option>@foreach(Category c in ViewBag.Categories){<option value="@c.Id" selected="@(ViewBag.Category == c.Id ? "selected" : null)">@c.Name</option>}</select></div><div class="col-md-3"><select name="sort" class="form-select"><option value="">Mới nhất</option><option value="price_asc" selected="@(ViewBag.Sort == "price_asc" ? "selected" : null)">Giá tăng dần</option><option value="price_desc" selected="@(ViewBag.Sort == "price_desc" ? "selected" : null)">Giá giảm dần</option></select></div><div class="col-md-1"><button class="btn btn-dark w-100">Lọc</button></div></form><p class="text-muted">@Model.Count sản phẩm</p><div class="row g-4">@foreach(var p in Model){<div class="col-6 col-lg-3">@await Html.PartialAsync("_ProductCard",p)</div>}</div>@if(!Model.Any()){<p>Không tìm thấy sản phẩm phù hợp.</p>}</div>

