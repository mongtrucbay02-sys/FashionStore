@model Product
@{ViewData["Title"]=Model.Name;}
<div class="container py-5"><div class="row g-5"><div class="col-md-6"><img class="detail-image" src="@Model.Image" alt="@Model.Name"/></div><div class="col-md-6"><div class="eyebrow dark">FASHION STORE · THỜI TRANG NAM</div><h1 class="mt-3">@Model.Name</h1><h3 class="mt-3">@Model.Price.ToString("N0") ₫</h3><p class="mt-4">@Model.Description</p><p><b>Màu sắc:</b> @Model.Color</p><p><b>Tồn kho:</b> @Model.Stock</p>@await Html.PartialAsync("_SizeAdvisor", new SizeAdvisorVM("select[name=size]", Model.CategoryId switch { 1 => "shirt", 2 => "pants", _ => "set" }))<form asp-controller="Cart" asp-action="Add" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id"/><div class="mb-3"><label>Chọn size</label><select name="size" class="form-select">@foreach(var s in Model.Sizes.Split(',')){<option value="@s.Trim()" disabled="@(Model.StockOf(s.Trim()) <= 0)">@s.Trim() (còn @Model.StockOf(s.Trim()))</option>}</select></div><div class="mb-3"><label>Số lượng</label><input type="number" name="quantity" min="1" max="@Model.Stock" value="1" class="form-control"/></div><button class="btn btn-dark btn-lg w-100" disabled="@(Model.Stock==0)">THÊM VÀO GIỎ HÀNG</button></form></div></div><hr class="my-5"/><h3>Đánh giá sản phẩm</h3>@foreach(Review r in ViewBag.Reviews){<div class="border-bottom py-3"><b>@r.UserName</b> <span class="text-warning">@(new string('★', r.Rating))</span><p>@r.Content</p></div>}<p class="text-muted">Đăng nhập để chia sẻ đánh giá của bạn.</p></div>


@if (User.Identity?.IsAuthenticated == true)
{
    <div class="container pb-5"><h3>Gửi đánh giá</h3><form asp-controller="Product" asp-action="Review" method="post">
        <input type="hidden" name="productId" value="@Model.Id" />
        <label for="review-rating" class="form-label">Số sao</label><select id="review-rating" name="rating" class="form-select mb-3"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select>
        <label for="review-content" class="form-label">Nội dung</label><textarea id="review-content" name="content" required maxlength="2000" class="form-control mb-3" rows="3"></textarea><button class="btn btn-dark" type="submit">Gửi đánh giá</button>
    </form></div>
}

