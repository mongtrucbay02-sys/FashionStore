@model ResetPasswordVM
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="card" style="max-width:440px;margin:auto">
    <h1>Quên mật khẩu</h1>
    @if (ViewBag.Message is string message) { <p role="status">@message</p> }
    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="All" class="err"></div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" required autocomplete="email" />
        <button class="btn" asp-action="SendResetCode" formnovalidate>Gửi mã OTP</button>
        <label asp-for="Code">Mã OTP</label>
        <input asp-for="Code" required autocomplete="one-time-code" inputmode="numeric" />
        <label asp-for="Password">Mật khẩu mới (ít nhất 8 ký tự)</label>
        <input asp-for="Password" required autocomplete="new-password" minlength="8" />
        <button class="btn full">Đặt lại mật khẩu</button>
    </form>
    <p><a asp-action="Login">Quay lại đăng nhập</a></p>
</div>
