@{ ViewData["CommercePage"] = true; }
@model RegisterVM
@{ ViewData["Title"] = "Đăng ký"; }
<div class="card" style="max-width:400px;margin:auto">
    <h2 class="center">ĐĂNG KÝ</h2>
    <p>Tạo tài khoản bằng email và mật khẩu, rồi xác thực OTP gửi đến Gmail.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" type="text" />
        <span asp-validation-for="FullName"></span>
        <label asp-for="Email">Email</label>
        <div style="display:flex;gap:8px;align-items:center">
            <input asp-for="Email" type="email" id="Email" style="flex:1" />
            <button type="button" id="sendOtpBtn" class="btn secondary">Gửi OTP</button>
        </div>
        <span asp-validation-for="Email"></span>
        <label asp-for="OtpCode"></label>
        <input asp-for="OtpCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
        <span asp-validation-for="OtpCode"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword"></span>
        <button class="btn full">ĐĂNG KÝ</button>
    </form>
    <p class="center"><a asp-action="Login">Đã có tài khoản? Đăng nhập</a></p>
</div>

@section Scripts {
    <script>
        document.getElementById('sendOtpBtn')?.addEventListener('click', async function () {
            const email = (document.getElementById('Email')?.value || '').trim();
            if (!email) { alert('Vui lòng nhập email trước khi gửi OTP.'); return; }
            const button = this;
            button.disabled = true;
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch('/Account/SendOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: new URLSearchParams({ email, __RequestVerificationToken: token })
                });
                const result = await response.json();
                alert(result.message || 'Đã gửi OTP.');
            } catch {
                alert('Không gửi được OTP. Kiểm tra cấu hình Gmail.');
            } finally { button.disabled = false; }
        });
    </script>
}



