@model Product
<div class="product-card"><a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id"><div class="product-image"><img src="@Model.Image" alt="@Model.Name" loading="lazy"/><span class="tag">NEW</span></div></a><div class="pt-3"><div class="text-muted small">@Model.Color · @Model.Sizes</div><a class="product-name" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a><div class="fw-bold mt-1">@Model.Price.ToString("N0") ₫</div></div></div>

