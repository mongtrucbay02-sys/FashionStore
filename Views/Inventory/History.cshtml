@model InventoryHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử tồn kho";
}
<h1>Lịch sử tồn kho</h1>

<div class="toolbar">
    <form method="get" asp-action="History">
        <select name="productId">
            <option value="">Tất cả sản phẩm</option>
            @foreach (var p in Model.Products)
            {
                <option value="@p.Id" selected="@(Model.ProductId == p.Id)">@p.Name</option>
            }
        </select>
        <button class="btn light" type="submit">Lọc</button>
    </form>
    <div class="spacer"></div>
    <a class="btn light" asp-action="ExportHistory" asp-route-productId="@Model.ProductId">Xuất Excel</a>
    <a class="btn light" asp-action="Index">← Tồn kho</a>
</div>

<div style="overflow-x:auto">
<table>
    <thead>
        <tr><th>Thời gian</th><th>Sản phẩm</th><th>Size</th><th>Loại</th><th class="num">Thay đổi</th><th class="num">Tồn sau</th><th>Ghi chú</th><th>Người thực hiện</th></tr>
    </thead>
    <tbody>
    @foreach (var m in Model.Movements)
    {
        <tr>
            <td>@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@m.ProductName</td>
            <td>@(m.Size.Length > 0 ? m.Size : "—")</td>
            <td>@m.Type</td>
            <td class="num" style="color:@(m.Change > 0 ? "var(--ok)" : "var(--err)")">@(m.Change > 0 ? "+" : "")@m.Change.ToString("N0")</td>
            <td class="num">@m.StockAfter.ToString("N0")</td>
            <td>
                @if (m.OrderId.HasValue) { <a asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@m.OrderId">@m.Note</a> }
                else { @m.Note }
            </td>
            <td>@m.By</td>
        </tr>
    }
    @if (!Model.Movements.Any()) { <tr><td colspan="8" class="empty">Chưa có biến động tồn kho.</td></tr> }
    </tbody>
</table>
</div>
@if (Model.Movements.Count == 300) { <p style="color:var(--muted);font-size:12px;margin-top:12px">Hiển thị 300 dòng gần nhất. Dùng "Xuất Excel" để lấy toàn bộ.</p> }
